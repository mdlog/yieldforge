# Local settings, copied to yieldforge/.env (git-ignored). You do not need this file to run the app:
# `npm run dev` and `npm run build` use the public testnet config in .env.testnet (committed), whose
# values win over this file for the keys it sets.

# Deploy key for scripts/ (deploy-series, roll-series, keeper, e2e). Never prefix with VITE_, never commit.
NEAR_ACCOUNT=
NEAR_PRIVATE_KEY=

# Test-only mock wallet for local e2e runs. Keep false/unset everywhere else.
# VITE_E2E_MOCK=false
