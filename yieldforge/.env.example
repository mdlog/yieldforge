# NEAR network: testnet | mainnet
VITE_NEAR_NETWORK=testnet
VITE_NEAR_NODE_URL=https://rpc.testnet.fastnear.com
# Contract overrides (defaults to testnet in lib/near/config.ts)
VITE_STNEAR_CONTRACT=meta-v2.pool.testnet
# v2: one series account is the vault, the YT token (NEP-141), the PT ledger and the marketplace.
# PT/YT/marketplace default to the series account when left unset.
VITE_SERIES_CONTRACT=stnear-90d-02.yieldforge.testnet
# Several series (a tenor ladder): comma-separated, first = default. When set, it replaces
# VITE_SERIES_CONTRACT and the PT/YT/marketplace overrides, and the app shows a series switcher.
# VITE_SERIES_CONTRACTS=stnear-7d-01.yieldforge.testnet,stnear-30d-01.yieldforge.testnet,stnear-90d-02.yieldforge.testnet
# VITE_PT_CONTRACT=
# VITE_YT_CONTRACT=
# VITE_MARKETPLACE_CONTRACT=
# Set to true only after contracts are deployed and verified
VITE_NEAR_LIVE=false
# Test-only mock wallet. Keep false/unset for production builds.
VITE_E2E_MOCK=false
