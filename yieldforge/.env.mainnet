# Public app configuration for NEAR mainnet, used by `npm run dev:mainnet` and `npm run build:mainnet` (--mode mainnet)
# and read by the scripts when NEAR_NETWORK=mainnet. Only VITE_* values: they are compiled into the browser bundle and
# visible to anyone. Deploy keys never go here; they live in the git-ignored yieldforge/.env.mainnet.local.
#
# NEAR Intents (the "From any chain" page) only works on mainnet, so this build is the one that sends real swaps.
VITE_NEAR_NETWORK=mainnet
VITE_NEAR_LIVE=true
VITE_STNEAR_CONTRACT=meta-pool.near
VITE_NEAR_NODE_URL=https://rpc.mainnet.fastnear.com
# Filled in by `NEAR_NETWORK=mainnet node scripts/roll-series.mjs ...` after each series is deployed.
VITE_SERIES_CONTRACTS=
