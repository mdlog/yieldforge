# Public app configuration for NEAR testnet, used by `npm run dev` and `npm run build` (--mode testnet)
# and read by the scripts. Only VITE_* values: they are compiled into the browser bundle and visible to
# everyone. Never put keys or secrets here; the deploy key stays in the git-ignored .env.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_LIVE=true
VITE_SERIES_CONTRACTS=stnear-7d-02.solidnecktie5405.testnet,stnear-7d-01.solidnecktie5405.testnet,stnear-30d-01.solidnecktie5405.testnet,stnear-90d-02.solidnecktie5405.testnet
VITE_SERIES_CONTRACT=stnear-90d-02.solidnecktie5405.testnet
VITE_PT_CONTRACT=stnear-90d-02.solidnecktie5405.testnet
VITE_YT_CONTRACT=stnear-90d-02.solidnecktie5405.testnet
VITE_MARKETPLACE_CONTRACT=stnear-90d-02.solidnecktie5405.testnet
VITE_STNEAR_CONTRACT=meta-v2.pool.testnet
VITE_NEAR_NODE_URL=https://rpc.testnet.fastnear.com
# Public signer of the hosted keeper (Railway cron). Shown in the docs so anyone can audit its calls; its key is not here.
VITE_KEEPER_ACCOUNT=keeper.solidnecktie5405.testnet
