{
  "name": "yieldforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode testnet",
    "build": "tsc -b && vite build --mode testnet",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "keeper": "node keeper.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "buffer": "^6.0.3",
    "lucide-react": "^0.468.0",
    "near-api-js": "^5.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.5"
  }
}
